<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="18" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eu.pp.aitools.controller.ToolsViewController">
    <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
    <Label styleClass="section-title" text="Available tools" />
    <Label fx:id="descriptionLabel" wrapText="true" />
    <TilePane hgap="16" vgap="16" prefColumns="3">
        <Button onAction="#openFileTool" prefHeight="170" prefWidth="170" styleClass="tool-tile">
            <graphic>
                <VBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="92" fitWidth="92" preserveRatio="true">
                        <image><Image url="@../image/files.png" /></image>
                    </ImageView>
                    <Label text="File Tools" />
                </VBox>
            </graphic>
        </Button>
    </TilePane>
</VBox>
