<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="18" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
    <VBox spacing="10" styleClass="metric-card">
        <Label styleClass="section-title" text="File workspace" />
        <Label text="Select a file to inspect or process it with the available actions." wrapText="true" />
        <HBox spacing="10">
            <TextField promptText="Choose a file..." HBox.hgrow="ALWAYS" />
            <Button text="Browse" />
        </HBox>
        <HBox spacing="10">
            <Button text="Inspect file" />
            <Button text="Process file" />
        </HBox>
    </VBox>
</VBox>
