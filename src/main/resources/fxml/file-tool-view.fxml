<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="14" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eu.pp.aitools.controller.FileToolController">
    <padding><Insets bottom="24" left="30" right="30" top="24" /></padding>
    <VBox spacing="10" styleClass="metric-card">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label styleClass="section-title" text="Folder summary" />
        </HBox>
        <HBox spacing="24">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Name" />
                <Label fx:id="folderNameLabel" styleClass="metric-value" text="No folder selected" />
            </VBox>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Files" />
                <Label fx:id="filesCountLabel" styleClass="metric-value" text="0" />
            </VBox>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Folders" />
                <Label fx:id="foldersCountLabel" styleClass="metric-value" text="0" />
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Folder" />
            <TextField fx:id="folderPathField" editable="false" styleClass="selected-path" promptText="Select a folder" HBox.hgrow="ALWAYS" />
            <Button fx:id="selectFolderButton" mnemonicParsing="false" onAction="#browseFolder" text="Select" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Rules (.md)" />
            <TextField fx:id="rulesFileField" editable="false" promptText="Select a Markdown rules file" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#browseRulesFile" text="Browse" />
        </HBox>
        <CheckBox fx:id="makeCopyCheckBox" mnemonicParsing="false" onAction="#toggleMakeCopy" text="Make copy" />
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Output folder" />
            <TextField fx:id="outputFolderField" editable="false" HBox.hgrow="ALWAYS" />
            <Button fx:id="outputFolderButton" mnemonicParsing="false" onAction="#browseOutputFolder" text="Browse" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Button fx:id="goButton" mnemonicParsing="false" onAction="#go" prefWidth="100" text="Go" />
            <Region HBox.hgrow="ALWAYS" />
            <ToggleButton fx:id="originalCleanedButton" mnemonicParsing="false" onAction="#toggleOriginalCleaned" prefWidth="100" text="Original" visible="false" managed="false" />
        </HBox>
    </VBox>
    <Label fx:id="statusLabel" text="Select a folder to view its contents" />
    <TableView fx:id="filesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="360" text="Name" />
            <TableColumn fx:id="modifiedColumn" prefWidth="190" text="Modified" />
            <TableColumn fx:id="sizeColumn" prefWidth="120" text="Size (bytes)" />
        </columns>
    </TableView>
</VBox>
