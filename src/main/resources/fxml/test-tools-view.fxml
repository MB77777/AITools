<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="testToolsRoot" spacing="12" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eu.pp.aitools.controller.TestToolsController">
    <padding><Insets bottom="24" left="30" right="30" top="24" /></padding>
    <Label styleClass="section-title" text="Test Tools" />
    <TextArea fx:id="promptTextArea" promptText="Enter your prompt" wrapText="true" />
    <Button fx:id="sendButton" mnemonicParsing="false" onAction="#sendPrompt" text="Send" />
    <TextArea fx:id="answerTextArea" editable="false" focusTraversable="false" promptText="LLM answers will appear here" wrapText="true" VBox.vgrow="ALWAYS" />
</VBox>
